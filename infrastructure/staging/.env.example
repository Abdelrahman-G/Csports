POSTGRES_DB=csports_staging
POSTGRES_USER=csports_staging_admin
# Generate a new random password; do not reuse infrastructure/.env.
POSTGRES_PASSWORD=
# Separate passwords for ordinary application queries and Flyway migrations.
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
# Required: a new random 64-character hexadecimal secret, separate from development.
JWT_SECRET=
STAGING_FRONTEND_PORT=3100
